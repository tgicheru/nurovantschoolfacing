import React, { useState, useEffect } from "react";
import { useRecoilValue } from "recoil";
import { useNavigate, Link } from "react-router-dom";
import authAtom from "../../../atoms/auth/auth.atom";
import { useDashboardService } from "../../../services/dashboard.service";
import { Card, Input, Tabs, Progress, Select, Button, Spin, message, Badge, Avatar, Tooltip, Row, Col, Empty } from 'antd';
import { SearchOutlined, ReloadOutlined, ArrowRightOutlined, CalendarOutlined, PlusOutlined, UserOutlined, BookOutlined, LineChartOutlined } from '@ant-design/icons';
import { FiClock, FiCalendar, FiUsers, FiBook, FiBarChart2, FiCheckCircle, FiAlertCircle } from 'react-icons/fi';
import { BsCheckCircle, BsCalendarEvent, BsGraphUp, BsBookmark } from 'react-icons/bs';

const { TabPane } = Tabs;

// Type definitions
interface Course {
  _id: string;
  userId: string;
  course_title: string;
  course_image?: string;
  state: string;
  grade: string;
  institution: string;
  curriculum_url: string;
  integrateWithGoogleCalendar: boolean;
  googleCalendarId: string | null;
  createdAt: string;
  updatedAt: string;
  __v: number;
  students: any[];
}

interface Lecture {
  _id: string;
  user: string;
  course: string;
  status: string;
  title: string;
  date: string;
  unit: string;
  sub_topic: string;
  topics: string[];
  quiz: string | null;
  flash_card: string | null;
  lesson_plan: string | null;
  recap: string | null;
  creative_assessment: string | null;
  curricullum_alignment: string | null;
  createdAt: string;
  updatedAt: string;
  __v: number;
  startTime?: string;
  endTime?: string;
  isIntegratedWithGoogleCalendar?: boolean;
  googleCalendarId?: string;
  googleEventId?: string | null;
  lessonPlan?: any | null;
}

interface CourseDeadline {
  course: Course;
  lecture: Lecture;
}

interface DashboardData {
  upcomingCourseDeadlines: CourseDeadline[];
  upcomingLectures: Lecture[];
  userCourses: Course[];
  todayLectures: Lecture[];
}

interface ClassData {
  id: string;
  name: string;
  students: number;
  averageScore: number;
  progress: number;
}

interface PerformanceData {
  week: string;
  score: number;
}

interface CalendarActivity {
  id: string;
  title: string;
  time: string;
  type: 'lecture' | 'assignment' | 'exam' | 'meeting';
  course: string;
  status?: 'upcoming' | 'completed' | 'pending';
}

interface TaskItem {
  icon: React.ReactNode;
  title: string;
  count: number;
  label: string;
}

const OverviewPage = () => {
  const navigate = useNavigate();
  const { user } = useRecoilValue(authAtom);
  const [selectedClass, setSelectedClass] = useState('1');
  const [selectedWeek, setSelectedWeek] = useState('1');
  const [selectedPerformanceClass, setSelectedPerformanceClass] = useState('1');
  const [loading, setLoading] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [dashboardData, setDashboardData] = useState<DashboardData | null>(null);

  // Calendar activity type definition
  interface CalendarActivity {
    id: string;
    title: string;
    time: string;
    type: 'lecture' | 'assignment' | 'exam' | 'meeting';
    course: string;
    status?: 'upcoming' | 'completed' | 'pending';
  }

  // Performance data type definition
  interface PerformanceData {
    week: string;
    score: number;
  }

  // State for calendar activities
  const [calendarActivities, setCalendarActivities] = useState<CalendarActivity[]>([]);
  // State for performance data
  const [performanceData, setPerformanceData] = useState<PerformanceData[]>([]);

  // Import dashboard service
  const dashboardService = useDashboardService();

  // Fetch dashboard data
  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        // Use the real API
        const data = await dashboardService.fetchDashboardData();
        setDashboardData(data);

        // Get today's date in YYYY-MM-DD format
        const today = new Date().toISOString().split('T')[0];
        // Get date 30 days from now
        const thirtyDaysLater = new Date();
        thirtyDaysLater.setDate(thirtyDaysLater.getDate() + 30);
        const endDate = thirtyDaysLater.toISOString().split('T')[0];

        // Fetch calendar activities
        try {
          const calendarData = await dashboardService.fetchCalendarActivities(today, endDate);
          // Transform API data to match our CalendarActivity interface
          const transformedActivities = calendarData.map((item: any) => ({
            id: item._id,
            title: item.title || 'Untitled Event',
            time: item.startTime || '00:00',
            type: determineEventType(item),
            course: item.courseName || 'All Classes',
            status: item.status?.toLowerCase() || 'upcoming'
          }));
          setCalendarActivities(transformedActivities);
        } catch (calendarError) {
          console.error('Error fetching calendar data:', calendarError);
        }

        // Fetch performance data for the first course if available
        if (data.userCourses && data.userCourses.length > 0) {
          try {
            const performanceResult = await dashboardService.fetchPerformanceData(
              data.userCourses[0]._id,
              'last9weeks'
            );
            
            // Transform performance data if available
            if (performanceResult && Array.isArray(performanceResult)) {
              const transformedPerformance = performanceResult.map((item: any, index: number) => ({
                week: `Week ${index + 1}`,
                score: item.averageScore || 0
              }));
              setPerformanceData(transformedPerformance);
            }
          } catch (perfError) {
            console.error('Error fetching performance data:', perfError);
            // Set default performance data if API fails
            setPerformanceData([
              { week: 'Week 1', score: 65 },
              { week: 'Week 2', score: 70 },
              { week: 'Week 3', score: 60 },
              { week: 'Week 4', score: 75 },
              { week: 'Week 5', score: 80 },
              { week: 'Week 6', score: 85 },
              { week: 'Week 7', score: 78 },
              { week: 'Week 8', score: 82 },
              { week: 'Week 9', score: 88 }
            ]);
          }
        }
      } catch (error) {
        console.error('Error fetching dashboard data:', error);
        message.error('Failed to load dashboard data');
      } finally {
        setLoading(false);
      }
    };

    // Helper function to determine event type
    const determineEventType = (event: any): 'lecture' | 'assignment' | 'exam' | 'meeting' => {
      if (event.type) {
        const type = event.type.toLowerCase();
        if (type.includes('lecture') || type.includes('class')) return 'lecture';
        if (type.includes('exam') || type.includes('quiz') || type.includes('test')) return 'exam';
        if (type.includes('assignment') || type.includes('homework')) return 'assignment';
        if (type.includes('meeting')) return 'meeting';
      }
      
      // Default to lecture if we can't determine
      return 'lecture';
    };

    fetchData();
  }, []);

  // Process upcoming lectures from API data or use fallback
  const upcomingTasks: TaskItem[] = dashboardData ? [
    // Show upcoming lectures
    {
      icon: <FiClock className="text-blue-500" />,
      title: 'Upcoming Lectures',
      count: dashboardData.upcomingLectures?.length || 0,
      label: 'lectures'
    },
    // Show today's lectures
    {
      icon: <FiCalendar className="text-purple-500" />,
      title: "Today's Lectures",
      count: dashboardData.todayLectures?.length || 0,
      label: 'today'
    },
    // Show courses
    {
      icon: <FiUsers className="text-green-500" />,
      title: 'Active Courses',
      count: dashboardData.userCourses?.length || 0,
      label: 'courses'
    }
  ] : [
    {
      icon: <FiClock className="text-blue-500" />,
      title: 'Upcoming Lectures',
      count: 0,
      label: 'lectures'
    },
    {
      icon: <FiCalendar className="text-purple-500" />,
      title: "Today's Lectures",
      count: 0,
      label: 'today'
    },
    {
      icon: <FiUsers className="text-green-500" />,
      title: 'Active Courses',
      count: 0,
      label: 'courses'
    }
  ];
  
  // Handle search input change
  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setSearchQuery(e.target.value);
  };

  // Handle creating a new course
  const handleCreateCourse = () => {
    navigate('/course');
  };

  // Handle navigating to student groups
  const handleStudentGroups = () => {
    navigate('/groups');
  };

  // Handle class selection change
  const handleClassChange = (value: string) => {
    setSelectedClass(value);
    
    // Fetch performance data for the selected class
    const fetchPerformanceForClass = async () => {
      try {
        setLoading(true);
        const performanceResult = await dashboardService.fetchPerformanceData(value, 'last9weeks');
        
        // Transform performance data if available
        if (performanceResult && Array.isArray(performanceResult)) {
          const transformedPerformance = performanceResult.map((item: any, index: number) => ({
            week: `Week ${index + 1}`,
            score: item.averageScore || 0
          }));
          setPerformanceData(transformedPerformance);
        }
      } catch (error) {
        console.error('Error fetching performance data for class:', error);
        message.error('Failed to load performance data');
      } finally {
        setLoading(false);
      }
    };
    
    fetchPerformanceForClass();
  };

  // Handle calendar item click
  const handleCalendarItemClick = (activityId: string) => {
    // Navigate to the specific activity page based on type
    const activity = calendarActivities.find(item => item.id === activityId);
    if (activity) {
      // For course-related activities, navigate to the course page with the activity's course ID
      // For meetings, navigate to the calendar event page
      if (activity.type === 'lecture' || activity.type === 'assignment' || activity.type === 'exam') {
        // Use the course ID from the activity data
        const courseId = typeof activity.course === 'string' ? activity.course : activity.id;
        navigate(`/course?id=${courseId}`);
      } else if (activity.type === 'meeting') {
        navigate(`/calendar/events/${activityId}`);
      }
    }
  };

  return (
    <div className="p-4 sm:p-6 max-w-7xl mx-auto">
      {/* Dashboard Header */}
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 md:mb-8">
        <div className="w-full md:w-auto">
          <h1 className="text-xl sm:text-2xl font-semibold text-[#101828] mb-1">Dashboard</h1>
          <p className="text-sm sm:text-base text-[#667085]">
            Welcome back, {user?.firstName || 'Educator'}! Here's what's happening with your classes today.
          </p>
        </div>
        <div className="flex flex-wrap w-full md:w-auto items-center gap-3">
          <Button 
            type="primary" 
            icon={<PlusOutlined />}
            className="bg-[#4970FC] hover:bg-[#3a5ad9] flex items-center text-sm sm:text-base flex-1 md:flex-none"
            onClick={handleCreateCourse}
          >
            Create Course
          </Button>
          <Button
            type="default"
            icon={<FiUsers className="mr-1" />}
            className="flex items-center border-[#4970FC] text-[#4970FC] hover:bg-[#EEF2FF] hover:border-[#3a5ad9] hover:text-[#3a5ad9] text-sm sm:text-base flex-1 md:flex-none"
            onClick={handleStudentGroups}
          >
            Student Groups
          </Button>
        </div>
      </div>

      {/* Loading State */}
      {loading ? (
        <div className="flex justify-center items-center h-64">
          <Spin size="large" />
        </div>
      ) : (
        <>
          {/* Stats Cards */}
          <Row gutter={[12, 12]} className="mb-6 md:mb-8">
            {upcomingTasks.map((task, index) => (
              <Col xs={24} sm={12} md={8} key={index}>
                <Card className="h-full shadow-sm hover:shadow-md transition-shadow">
                  <div className="flex items-center">
                    <div className="p-3 rounded-full bg-[#F9FAFB] mr-4">
                      {task.icon}
                    </div>
                    <div>
                      <p className="text-[#667085] text-sm mb-1">{task.title}</p>
                      <p className="text-xl font-semibold text-[#101828]">
                        {task.count} {task.label}
                      </p>
                    </div>
                  </div>
                </Card>
              </Col>
            ))}
          </Row>

          {/* Main Content */}
          <Row gutter={[16, 16]} className="mb-4">
            {/* Today's Lessons */}
            <Col xs={24} lg={16} className="mb-4 lg:mb-0">
              <Card 
                title="Today's Lessons" 
                className="mb-6 shadow-sm"
                extra={<Button type="link" onClick={() => navigate('/course')}>View All</Button>}
              >
                {dashboardData?.todayLectures && dashboardData.todayLectures.length > 0 ? (
                  dashboardData.todayLectures.map((lecture, index) => {
                    // Find the course for this lecture
                    const course = dashboardData.userCourses.find(c => c._id === lecture.course) || null;
                    return (
                      <div 
                        key={lecture._id} 
                        className="flex items-center p-4 border-b last:border-b-0 hover:bg-gray-50 transition-colors cursor-pointer"
                        onClick={() => navigate(`/course?id=${lecture.course}`)}
                      >
                        <div className="flex-shrink-0 mr-3 sm:mr-4">
                          <Avatar 
                            size={40} 
                            icon={<BookOutlined />} 
                            className="bg-[#4970FC]" 
                            src={course?.course_image}
                          />
                        </div>
                        <div className="flex-grow">
                          <div className="flex justify-between items-start">
                            <div>
                              <h3 className="font-medium text-[#101828] text-sm sm:text-base">{lecture.title}</h3>
                              <p className="text-xs sm:text-sm text-[#667085]">{course?.course_title || 'Unknown Course'}</p>
                            </div>
                            <Badge 
                              status={lecture.status === 'COMPLETED' ? 'success' : 'processing'} 
                              text={lecture.status === 'COMPLETED' ? 'Completed' : 'Pending'} 
                            />
                          </div>
                          <div className="flex justify-between items-center mt-2">
                            <p className="text-xs text-[#667085] flex flex-wrap gap-2">
                              <span>
                                <FiClock className="inline mr-1" />
                                {lecture.startTime} - {lecture.endTime}
                              </span>
                              <span>
                                <FiBook className="inline mr-1" />
                                Unit {lecture.unit}
                              </span>
                            </p>
                            <Tooltip title="View Lesson Details">
                              <ArrowRightOutlined className="text-[#4970FC]" />
                            </Tooltip>
                          </div>
                        </div>
                      </div>
                    );
                  })
                ) : (
                  <Empty description="No lessons scheduled for today" />
                )}
              </Card>

              {/* Class Overview */}
              <Card 
                title="Class Overview" 
                className="mb-6 shadow-sm"
                extra={<Button type="link" onClick={() => navigate('/course')}>View All Classes</Button>}
              >
                {dashboardData?.userCourses && dashboardData.userCourses.length > 0 ? (
                  dashboardData.userCourses.map((course, index) => (
                    <Link
                      key={course._id}
                      to={`/course?id=${course._id}`}
                      className="block border-b last:border-b-0 py-4 cursor-pointer hover:bg-gray-50 transition-colors no-underline"
                    >
                      <div className="flex justify-between items-center mb-3">
                        <h3 className="text-sm sm:text-base font-medium text-[#101828] line-clamp-1">{course.course_title}</h3>
                        <ArrowRightOutlined className="text-[#4970FC]" />
                      </div>
                      <div className="flex justify-between items-center mb-2">
                        <span className="text-sm text-[#667085]">Progress</span>
                        <span className="text-sm font-medium">75%</span>
                      </div>
                      <Progress percent={75} strokeColor="#4970FC" showInfo={false} />
                      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center mt-3 text-xs sm:text-sm text-[#667085] gap-2 sm:gap-0">
                        <span><UserOutlined className="mr-1" />{course.students?.length || 0} students</span>
                        <span><LineChartOutlined className="mr-1" />Avg. Score: 80%</span>
                      </div>
                    </Link>
                  ))
                ) : (
                  <Empty description="No courses available" />
                )}
              </Card>
            </Col>

            {/* Right Column */}
            <Col xs={24} lg={8} className="mb-4 lg:mb-0">
              {/* Calendar */}
              <Card 
                title="Calendar" 
                className="mb-6 shadow-sm"
                extra={<Button type="link" onClick={() => navigate('/calendar')}>View Calendar</Button>}
              >
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-base font-medium text-[#101828]">Today's Activities</h3>
                  <CalendarOutlined className="text-[#4970FC]" />
                </div>
                {calendarActivities.length > 0 ? (
                  calendarActivities.slice(0, 4).map((activity, index) => (
                    <div 
                      key={index} 
                      className="p-3 border-b last:border-b-0 hover:bg-gray-50 transition-colors cursor-pointer flex items-center"
                      onClick={() => handleCalendarItemClick(activity.id)}
                    >
                      <div className="mr-3">
                        {activity.type === 'lecture' && <FiBook className="text-blue-500" />}
                        {activity.type === 'assignment' && <FiCheckCircle className="text-green-500" />}
                        {activity.type === 'exam' && <FiAlertCircle className="text-red-500" />}
                        {activity.type === 'meeting' && <FiUsers className="text-purple-500" />}
                      </div>
                      <div className="flex-grow">
                        <p className="font-medium text-[#101828] text-sm line-clamp-1">{activity.title}</p>
                        <p className="text-xs text-[#667085] line-clamp-1">
                          {activity.time} · {activity.course}
                        </p>
                      </div>
                      <ArrowRightOutlined className="text-[#4970FC]" />
                    </div>
                  ))
                ) : (
                  <Empty description="No upcoming activities" />
                )}
                <div className="mt-4 text-center">
                  <Button 
                    type="default" 
                    icon={<PlusOutlined />}
                    size="middle"
                    className="text-sm"
                    onClick={() => navigate('/calendar/create-event')}
                  >
                    Add Event
                  </Button>
                </div>
              </Card>

              {/* Performance Chart */}
              <Card 
                title="Class Performance" 
                className="shadow-sm"
                extra={
                  <Select 
                    defaultValue={dashboardData?.userCourses && dashboardData.userCourses.length > 0 ? dashboardData.userCourses[0]._id : ''} 
                    style={{ width: 120 }}
                    onChange={handleClassChange}
                    options={dashboardData?.userCourses?.map(course => ({ 
                      value: course._id, 
                      label: course.course_title 
                    })) || []}
                  />
                }
              >
                <div className="h-64">
                  {performanceData.length > 0 ? (
                    <div className="flex h-full">
                      {performanceData.map((item, index) => (
                        <div key={index} className="flex flex-col items-center justify-end h-full flex-1">
                          <div 
                            className="w-8 bg-[#4970FC] opacity-70 rounded-t-md" 
                            style={{ height: `${item.score}%` }}
                          ></div>
                          <p className="text-xs mt-2">{item.week.split(' ')[1]}</p>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div className="flex items-center justify-center h-full">
                      <Empty description="No performance data available" />
                    </div>
                  )}
                </div>
              </Card>
            </Col>
          </Row>
        </>
      )}

      {/* Footer */}
      <div className="text-xs text-[#667085] mt-6 md:mt-8 text-center">
        © NurovantAI 2024. All rights reserved.
      </div>
    </div>
  );
};

export default OverviewPage;
